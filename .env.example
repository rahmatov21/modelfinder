# ==============================================================================
# OpenRouter Telegram Bot Configuration
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Your Telegram User ID (get from @userinfobot or @raw_data_bot on Telegram)
# You can specify multiple admin IDs separated by commas (e.g. 12345678,87654321)
ADMIN_USER_ID=your_telegram_user_id_here

# 3. Target Telegram Channel Username or ID (e.g. @my_ai_channel or -1001234567890)
# Make sure your bot is added as an Administrator in this channel with post permissions!
TELEGRAM_CHANNEL_ID=@your_channel_username

# 4. OpenRouter API Key (get from https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. Model to use for generating and refining posts with AI
# Examples: google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat
DEFAULT_AI_MODEL=google/gemini-2.5-flash

# 6. Polling interval in minutes (how often to check for new models)
CHECK_INTERVAL_MINUTES=15

# 7. Auto-post mode:
# - false (recommended): Newly discovered models are sent to you first as an approval draft with buttons (Publish, AI Refine, Edit, Discard).
# - true: Automatically publishes directly to the Telegram Channel when a new model is found.
AUTO_POST_TO_CHANNEL=false
